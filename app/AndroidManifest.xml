<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mg4.launcher">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Bluetooth and Wi-Fi indicators at top right -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- 0.4.3: Bluetooth phone contacts for the "Phone favourites" in the panel below the station -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- 0.4.4: the launcher writes the day/night theme to the system (Settings.System SKIN_THEME_CONFIG, like the SAIC EH32 apps) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- 1.0.4: car lights (position, low beam, stalk) for the headlights and the theme -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_LIGHTS" />
    <!-- 1.0.4: bring the already open window back to front after reverse gear -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- CarService: tyre pressure (TPMS) and cabin temperature -->
    <uses-permission android:name="android.car.permission.CAR_TIRES" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_ENGINE_DETAILED" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />
    <!-- fork 0.4.8: windows via CarService properties (VEHICLE_DRIVERWINDOW…), like MG4Control -->
    <uses-permission android:name="android.car.permission.CONTROL_CAR_SEATS" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_WINDOWS" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <!-- granted automatically because the app is signed with the system platform key -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <!-- start at power-on and re-confirm the default home -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SET_PREFERRED_APPLICATIONS" />
    <!-- safe start: disables only the MG home screen (platform signature) -->
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
    <!-- permanent enabling of the accessibility service (granted by the platform signature) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- update from GitHub without confirmation (system permission, granted by the platform signature) -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- user radio logos (MG4Launcher/loghi folder on storage or USB stick): the permission is granted automatically -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- fork: "Save log" to visible folders (Download/MG4Launcher and MG4Launcher/registos on the USB stick);
         WRITE_MEDIA_STORAGE (granted by the platform signature) allows writing to the USB stick root -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_MEDIA_STORAGE" />
    <uses-permission android:name="android.permission.GRANT_RUNTIME_PERMISSIONS" />

    <!-- 0.8.2: CarPlay/AA dongle restart (USB permission and port reset, stopping the Allgo service) -->
    <uses-permission android:name="android.permission.MANAGE_USB" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <!-- 0.3.3: uninstall from settings, without a computer -->
    <uses-permission android:name="android.permission.DELETE_PACKAGES" />

    <!-- SWI69: battery manager ("bms"), climate and lights from CarService, granted by the platform signature -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY_PORTS" />
    <uses-permission android:name="android.car.permission.CAR_HVAC" />
    <uses-permission android:name="android.car.permission.CAR_POWER" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_RADIO" />
    <!-- 0.4.2: measures the SystemUI light indicator window (dumpsys window, read-only; platform signature) -->
    <uses-permission android:name="android.permission.DUMP" />
    <!-- fork: read crashes and Android Auto/CarPlay lines into the saved log (granted by the platform signature) -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <!-- 0.4.2: sunrise and sunset for the automatic theme (last known location, the launcher never turns on GPS) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <!-- cameras: EvsService of the original home -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- built-in climate screen (from MG4 Clima): close the shade the system opens when the climate turns on, block it
         while the screen is in front, zone and panel over the top bar during Android Auto / CarPlay (platform signature) -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.STATUS_BAR" />
    <uses-permission android:name="android.permission.STATUS_BAR_SERVICE" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />

    <application android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/LauncherTheme"
        android:supportsRtl="false"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true">

        <!-- CarService library (present in the car; optional elsewhere) -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:directBootAware="false"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|locale|layoutDirection|density|fontScale"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- safe start: home for the first seconds before unlock (priority -1, below the real launcher) -->
        <activity
            android:name=".BootSplashActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:exported="true">
            <intent-filter android:priority="-1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- at power-on the firmware opens the MG home by name: this receiver brings the launcher back to front -->
        <receiver
            android:name=".svc.BootWatcher"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- only to know which app comes to front at power-on (no screen content) -->
        <service
            android:name=".svc.BootAccessibility"
            android:label="@string/app_name"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_boot" />
        </service>

        <!-- built-in climate screen (from MG4 Clima): opens from the climate button and instead of the original climate app -->
        <activity
            android:name=".climate.ClimateActivity"
            android:launchMode="singleTask"
            android:taskAffinity="com.mg4.launcher.climate"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/ClimateTheme"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|locale|layoutDirection|density|fontScale"
            android:exported="false" />

        <!-- only to know when the original climate app comes to the front (no screen content) and, with the climate
             screen in front, the steering wheel keys paired with the joystick commands -->
        <service
            android:name=".climate.ClimateGuard"
            android:label="@string/cl_app_name"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_climate" />
        </service>

        <receiver
            android:name=".svc.TokenReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
