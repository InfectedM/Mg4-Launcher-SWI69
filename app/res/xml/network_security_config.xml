<?xml version="1.0" encoding="utf-8"?>
<!--
  Root certificates for HTTPS connections (radio logos, updates, log upload), in addition to the system ones.
  The car's Android 9 does not know the newer Sectigo roots: GitHub uses Sectigo chains (e.g. "Sectigo Public Server
  Authentication CA DV E36", which leads to the E46 root or, via cross-signing, to USERTrust ECC).
  Roots from the Mozilla CA store: USERTrust RSA and ECC, Sectigo Public Server Authentication Root R46 and E46.
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/usertrust_rsa" />
            <certificates src="@raw/usertrust_ecc" />
            <certificates src="@raw/sectigo_root_r46" />
            <certificates src="@raw/sectigo_root_e46" />
        </trust-anchors>
    </base-config>
</network-security-config>
